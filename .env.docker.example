# Copy to .env.docker and fill these private values before running Compose.
# DATABASE_URL shape: postgresql://nipopeto:<URL-encoded-password>@postgres:5432/nipopeto?schema=public
POSTGRES_PASSWORD=
DATABASE_URL=
JWT_SECRET=
# After filling Core values, run: node tools/docker/prepare-notifications.mjs
# For all three services use: node tools/docker/prepare-phase2.mjs
# Then pass BOTH -f docker-compose.yml -f docker-compose.phase2.yml to Compose.
# This appends RSA keys and Notification/broker credentials without changing DB values.
# JWT_SECRET remains for legacy scripts; Compose API now signs RS256 tokens.
PORT=5000
FRONTEND_PORT=5173
CORS_ORIGIN=http://localhost:5173
VNPAY_TMN_CODE=
VNPAY_ENABLED=false
BANK_TRANSFER_DEMO=true
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_BANK_BIN=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_ACCOUNT_HOLDER=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:5173/owner/billing
