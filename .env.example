# Frontend
# Vite exposes only variables prefixed with VITE_ to browser code.
VITE_API_BASE_URL=http://localhost:5000/api

# Backend
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Database, used by Prisma when moving from JSON/mock storage to PostgreSQL.
DATABASE_URL=postgresql://user:password@localhost:5432/nipopeto

