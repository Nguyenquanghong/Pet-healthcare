FROM node:24-bookworm-slim AS base
WORKDIR /work
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*

FROM base AS build
COPY package.json package-lock.json ./
COPY backend/package.json backend/package.json
COPY frontend/package.json frontend/package.json
COPY services/clinic/package.json services/clinic/package.json
COPY services/notification/package.json services/notification/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/messaging/package.json packages/messaging/package.json
COPY packages/runtime/package.json packages/runtime/package.json
COPY tools/vendor/braces tools/vendor/braces
RUN npm ci --workspace @nipopeto/backend --workspace @nipopeto/contracts --workspace @nipopeto/messaging --workspace @nipopeto/runtime --include-workspace-root
COPY packages/contracts packages/contracts
COPY packages/messaging packages/messaging
COPY packages/runtime packages/runtime
COPY backend backend
COPY tools/phase2/copy-core-client.mjs tools/phase2/copy-core-client.mjs
RUN npm run build --workspace @nipopeto/runtime && npm run build --workspace @nipopeto/contracts && npm run build --workspace @nipopeto/messaging && npm run build --workspace @nipopeto/backend

FROM build AS production-deps
RUN npm prune --omit=dev --workspace @nipopeto/backend --workspace @nipopeto/contracts --workspace @nipopeto/messaging --workspace @nipopeto/runtime --include-workspace-root

FROM base AS runtime
ENV NODE_ENV=production HOST=0.0.0.0
COPY --from=build /work/package.json ./package.json
COPY --from=build /work/backend/package.json ./backend/package.json
COPY --from=production-deps /work/node_modules ./node_modules
COPY --from=build /work/node_modules/.prisma /work/node_modules/.prisma
COPY --from=build /work/packages/contracts/package.json ./packages/contracts/package.json
COPY --from=build /work/packages/contracts/dist ./packages/contracts/dist
COPY --from=build /work/packages/messaging/package.json ./packages/messaging/package.json
COPY --from=build /work/packages/messaging/dist ./packages/messaging/dist
COPY --from=build /work/packages/runtime/package.json ./packages/runtime/package.json
COPY --from=build /work/packages/runtime/dist ./packages/runtime/dist
COPY --from=build /work/backend/dist /work/backend/dist
COPY tools/docker/core-local-start.mjs tools/docker/core-local-start.mjs
USER node
EXPOSE 5000
CMD ["node", "backend/dist/src/index.js"]

# Notification uses the same dependency versions as Core. Reuse the build layer
# rather than downloading a second node_modules tree for the local composition.
FROM build AS notification-build
COPY services/notification services/notification
COPY tools/phase2/copy-client.mjs tools/phase2/copy-client.mjs
RUN npm run build --workspace @nipopeto/notification

FROM runtime AS notification-runtime
COPY --from=notification-build /work/services/notification/package.json ./services/notification/package.json
COPY --from=notification-build /work/services/notification/dist ./services/notification/dist
EXPOSE 5102
CMD ["node", "services/notification/dist/index.js"]

FROM build AS clinic-build
COPY services/clinic services/clinic
COPY tools/phase2/copy-client.mjs tools/phase2/copy-client.mjs
RUN npm run build --workspace @nipopeto/clinic

FROM runtime AS clinic-runtime
COPY --from=clinic-build /work/services/clinic/package.json ./services/clinic/package.json
COPY --from=clinic-build /work/services/clinic/dist ./services/clinic/dist
EXPOSE 5101
CMD ["node", "services/clinic/dist/index.js"]
