FROM node:24-bookworm-slim AS build
WORKDIR /work
COPY package.json package-lock.json ./
COPY backend/package.json backend/package.json
COPY frontend/package.json frontend/package.json
COPY services/clinic/package.json services/clinic/package.json
COPY services/notification/package.json services/notification/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/messaging/package.json packages/messaging/package.json
COPY packages/runtime/package.json packages/runtime/package.json
COPY tools/vendor/braces tools/vendor/braces
RUN npm ci --workspace @nipopeto/frontend --include-workspace-root=false
COPY backend/src/domain/pricing.json backend/src/domain/pricing.json
COPY frontend frontend
ENV VITE_API_BASE_URL=/api
RUN npm run build --workspace @nipopeto/frontend

FROM nginxinc/nginx-unprivileged:stable-alpine AS runtime
COPY frontend/nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /work/frontend/dist /usr/share/nginx/html
ENV API_PORT=5000
EXPOSE 8080
