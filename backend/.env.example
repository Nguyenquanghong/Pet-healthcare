NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql://nipopeto:nipopeto@localhost:5432/nipopeto?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
# Phase 1: manual bank transfer; demo details are visibly marked, never transfer real money.
BANK_TRANSFER_DEMO=true
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_BANK_BIN=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_ACCOUNT_HOLDER=
# Phase 2: VNPay is disabled by default.
VNPAY_ENABLED=false
# VNPay Sandbox merchant credentials from https://sandbox.vnpayment.vn/devreg/
# Leave empty to disable online checkout. Never put the secret in VITE_* or Git.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:5173/owner/billing

# P08: Core gateway Circuit Breakers for the split services (defaults shown).
# After FAILURES consecutive transport errors or 502/503/504, the gateway answers
# 503 at once for OPEN_MS, then lets one probe through.
# CLINIC_GATEWAY_BREAKER_FAILURES=5
# CLINIC_GATEWAY_BREAKER_OPEN_MS=5000
# NOTIFICATION_GATEWAY_BREAKER_FAILURES=5
# NOTIFICATION_GATEWAY_BREAKER_OPEN_MS=5000
