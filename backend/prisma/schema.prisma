datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  owner
  doctor
  staff
  admin
}

enum PetSpecies {
  dog
  cat
  rabbit
  other
}

enum PetGender {
  male
  female
  unknown
}

enum PetHealthStatus {
  healthy
  stable
  vaccination_due
  under_treatment
  critical
}

enum AppointmentStatus {
  pending
  confirmed
  checked_in
  in_progress
  completed
  cancelled
  no_show
}

enum AppointmentType {
  general_checkup
  vaccination
  dental
  dermatology
  surgery
  hotel_consultation
  spa_bath
  spa_grooming
  spa_combo
  other
}

enum HotelBookingStatus {
  pending
  confirmed
  in_stay
  checked_out
  cancelled
  rejected
}

enum RoomType {
  standard
  deluxe
  vip
}

enum PaymentStatus {
  paid
  unpaid
  refunded
}

enum PaymentMethod {
  cash
  bank_transfer
  credit_card
  qr_code
  vnpay
}

model User {
  id             String   @id @default(uuid())
  username       String?  @unique
  phone          String?  @unique
  email          String?  @unique
  passwordHash   String   @map("password_hash")
  passwordSalt   String   @map("password_salt")
  fullName       String   @map("full_name")
  role           Role     @default(owner)
  address        String?
  avatarUrl      String?  @map("avatar_url")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  pets           Pet[]
  appointments   Appointment[]   @relation("OwnerAppointments")
  doctorAppts    Appointment[]   @relation("DoctorAppointments")
  medicalRecords MedicalRecord[]
  hotelBookings  HotelBooking[]
  invoices       Invoice[]
  notifications  Notification[]  @relation("OwnerNotifications")
  activations    OwnerActivation[]

  @@map("users")
}

model OwnerActivation {
  id           String   @id @default(uuid())
  ownerId      String   @map("owner_id")
  tokenHash    String   @unique @map("token_hash")
  email        String
  expiresAt    DateTime @map("expires_at")
  usedAt       DateTime? @map("used_at")
  revokedAt    DateTime? @map("revoked_at")
  issuedBy     String   @map("issued_by")
  issuedByName String   @map("issued_by_name")
  createdAt    DateTime @default(now()) @map("created_at")
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@map("owner_activations")
}

model Pet {
  id                String          @id @default(uuid())
  ownerId           String          @map("owner_id")
  name              String
  species           PetSpecies
  breed             String?
  gender            PetGender       @default(unknown)
  ageLabel          String?         @map("age_label")
  weightKg          Decimal?        @map("weight_kg") @db.Decimal(5, 2)
  microchipId       String?         @unique @map("microchip_id")
  healthStatus      PetHealthStatus @default(healthy) @map("health_status")
  allergies         String[]
  notes             String?
  avatarUrl         String?         @map("avatar_url") @db.Text
  identifyingMarks  String?         @map("identifying_marks")
  lastSeenLocation  String?         @map("last_seen_location")
  qrToken           String?         @unique @map("qr_token")
  qrEnabled         Boolean         @default(true) @map("qr_enabled")
  showOwnerPhone    Boolean         @default(true) @map("show_owner_phone")
  showOwnerEmail    Boolean         @default(false) @map("show_owner_email")
  showOwnerAddress  Boolean         @default(false) @map("show_owner_address")
  showMedicalAlerts Boolean         @default(true) @map("show_medical_alerts")
  rescueNote        String?         @map("rescue_note")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  owner             User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  appointments      Appointment[]
  medicalRecords    MedicalRecord[]
  medicalImages     MedicalImage[]
  hotelBookings     HotelBooking[]
  invoices          Invoice[]
  rescueReports     RescueReport[]

  @@index([ownerId])
  @@map("pets")
}

model Appointment {
  id              String            @id @default(uuid())
  petId           String            @map("pet_id")
  ownerId         String            @map("owner_id")
  doctorId        String?           @map("doctor_id")
  type            AppointmentType
  serviceName     String            @map("service_name")
  clinicName      String            @map("clinic_name")
  appointmentDate DateTime          @map("appointment_date") @db.Date
  appointmentTime String            @map("appointment_time")
  status          AppointmentStatus @default(pending)
  statusRevision  Int               @default(0) @map("status_revision")
  ownerNote       String?           @map("owner_note")
  internalNote    String?           @map("internal_note")
  createdBy       String            @default("owner") @map("created_by")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  pet             Pet               @relation(fields: [petId], references: [id], onDelete: Cascade)
  owner           User              @relation("OwnerAppointments", fields: [ownerId], references: [id], onDelete: Cascade)
  doctor          User?             @relation("DoctorAppointments", fields: [doctorId], references: [id])
  medicalRecords  MedicalRecord[]
  invoices        Invoice[]

  @@index([ownerId, appointmentDate])
  @@map("appointments")
}

model MedicalRecord {
  id            String    @id @default(uuid())
  petId         String    @map("pet_id")
  ownerId       String    @map("owner_id")
  appointmentId String?   @map("appointment_id")
  doctorName    String    @map("doctor_name")
  visitDate     DateTime  @map("visit_date") @db.Date
  title         String
  symptoms      String?
  diagnosis     String
  treatment     String
  medications   String?
  vaccineName   String?   @map("vaccine_name")
  followUpDate  DateTime? @map("follow_up_date") @db.Date
  weightKg      Decimal?  @map("weight_kg") @db.Decimal(5, 2)
  temperatureC  Decimal?  @map("temperature_c") @db.Decimal(4, 1)
  heartRateBpm  Int?      @map("heart_rate_bpm")
  internalNote  String?   @map("internal_note")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  pet           Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([petId, visitDate])
  @@map("medical_records")
}

model MedicalImage {
  id        String   @id @default(uuid())
  petId     String   @map("pet_id")
  title     String
  imageUrl  String   @map("image_url") @db.Text
  mimeType  String   @map("mime_type")
  createdAt DateTime @default(now()) @map("created_at")
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
  @@map("medical_images")
}

model HotelBooking {
  id             String             @id @default(uuid())
  petId          String             @map("pet_id")
  ownerId        String             @map("owner_id")
  checkIn        DateTime           @map("check_in") @db.Date
  checkOut       DateTime           @map("check_out") @db.Date
  nights         Int
  roomType       RoomType           @map("room_type")
  serviceKeys    String[]           @map("service_keys")
  totalAmount    Decimal            @map("total_amount") @db.Decimal(12, 2)
  status         HotelBookingStatus @default(pending)
  statusRevision Int                @default(0) @map("status_revision")
  ownerNote      String?            @map("owner_note")
  internalNote   String?            @map("internal_note")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  pet            Pet                @relation(fields: [petId], references: [id], onDelete: Cascade)
  owner          User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  dailyCareNotes DailyCareNote[]
  invoices       Invoice[]
  createRequests HotelBookingRequest[]

  @@index([ownerId, checkIn])
  @@map("hotel_bookings")
}

model HotelBookingRequest {
  actorId     String   @map("actor_id")
  requestKey  String   @map("request_key")
  fingerprint String
  bookingId   String   @map("booking_id")
  createdAt   DateTime @default(now()) @map("created_at")
  booking     HotelBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@id([actorId, requestKey])
  @@index([bookingId])
  @@map("hotel_booking_requests")
}

model BookingStatusEvent {
  id          String @id @default(uuid())
  kind        String
  bookingId   String @map("booking_id")
  revision    Int
  action      String
  fromStatus  String @map("from_status")
  toStatus    String @map("to_status")
  actorId     String @map("actor_id")
  actorName   String @map("actor_name")
  actorRole   String @map("actor_role")
  reason      String?
  reversesId  String? @unique @map("reverses_id")
  reverses    BookingStatusEvent? @relation("BookingReversal", fields: [reversesId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reversedBy  BookingStatusEvent? @relation("BookingReversal")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([kind, bookingId, revision])
  @@index([kind, bookingId, createdAt], map: "booking_status_events_booking_idx")
  @@map("booking_status_events")
}

model DailyCareNote {
  id               String   @id @default(uuid())
  bookingId        String   @map("booking_id")
  noteDate         DateTime @map("note_date") @db.Date
  eatingStatus     String   @default("normal") @map("eating_status")
  mood             String   @default("calm")
  note             String
  visibleToOwner   Boolean  @default(true) @map("visible_to_owner")
  createdByStaffId String?  @map("created_by_staff_id")
  createdAt        DateTime @default(now()) @map("created_at")
  booking          HotelBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, noteDate])
  @@map("daily_care_notes")
}

model Notification {
  id                   String   @id @default(uuid())
  recipientOwnerId     String?  @map("recipient_owner_id")
  recipientRole        String   @default("owner") @map("recipient_role")
  type                 String
  title                String
  message              String
  status               String   @default("sent")
  actionUrl            String?  @map("action_url")
  relatedPetId         String?  @map("related_pet_id")
  relatedAppointmentId String?  @map("related_appointment_id")
  relatedBookingId     String?  @map("related_booking_id")
  sentByStaffId        String?  @map("sent_by_staff_id")
  createdAt            DateTime @default(now()) @map("created_at")
  sentAt               DateTime @default(now()) @map("sent_at")
  recipientOwner       User?    @relation("OwnerNotifications", fields: [recipientOwnerId], references: [id], onDelete: Cascade)

  @@index([recipientOwnerId, createdAt])
  @@map("notifications")
}

model RescueReport {
  id          String   @id @default(uuid())
  petId       String   @map("pet_id")
  finderName  String?  @map("finder_name")
  finderPhone String   @map("finder_phone")
  location    String
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  pet         Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId, createdAt])
  @@map("rescue_reports")
}

model Invoice {
  id             String         @id @default(uuid())
  invoiceCode    String         @unique @map("invoice_code")
  transferCode   String?        @unique @default(dbgenerated("('NIPO'::text || lpad((nextval('invoice_transfer_code_seq'::regclass))::text, 10, '0'::text))")) @map("transfer_code")
  type           String
  ownerId        String         @map("owner_id")
  petId          String         @map("pet_id")
  appointmentId  String?        @unique @map("appointment_id")
  hotelBookingId String?        @unique @map("hotel_booking_id")
  subtotal       Decimal        @db.Decimal(12, 2)
  taxAmount      Decimal        @default(0) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount Decimal        @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount    Decimal        @map("total_amount") @db.Decimal(12, 2)
  paymentStatus  PaymentStatus  @default(unpaid) @map("payment_status")
  paymentMethod  PaymentMethod? @map("payment_method")
  paymentChannel String?        @map("payment_channel")
  bankTransferDetails Json?      @map("bank_transfer_details")
  transferReviewStatus String?   @map("transfer_review_status")
  transferReportedAt DateTime?   @map("transfer_reported_at")
  transferReference String?      @map("transfer_reference")
  transferReviewNote String?     @map("transfer_review_note")
  issuedAt       DateTime       @default(now()) @map("issued_at")
  paidAt         DateTime?      @map("paid_at")
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  owner          User           @relation(fields: [ownerId], references: [id])
  pet            Pet            @relation(fields: [petId], references: [id])
  appointment    Appointment?   @relation(fields: [appointmentId], references: [id])
  hotelBooking   HotelBooking?  @relation(fields: [hotelBookingId], references: [id])
  items          InvoiceItem[]
  paymentAttempts PaymentAttempt[]
  paymentEvents PaymentEvent[]

  @@index([ownerId, issuedAt])
  @@map("invoices")
}

model PaymentEvent {
  id          String   @id @default(uuid())
  invoiceId   String   @map("invoice_id")
  action      String
  fromStatus  String   @map("from_status")
  toStatus    String   @map("to_status")
  actorId     String   @map("actor_id")
  actorName   String   @map("actor_name")
  actorRole   String   @map("actor_role")
  reason      String?
  reference   String?
  createdAt   DateTime @default(now()) @map("created_at")
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, createdAt])
  @@map("payment_events")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String  @map("invoice_id")
  description String
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  quantity    Int     @default(1)
  amount      Decimal @db.Decimal(12, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model PaymentAttempt {
  id             String   @id
  invoiceId      String   @map("invoice_id")
  amount         Decimal  @db.Decimal(12, 2)
  status         String   @default("pending")
  transactionNo  String?  @unique @map("transaction_no")
  responseCode   String?  @map("response_code")
  createdAt      DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @map("expires_at")
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  @@index([invoiceId, createdAt])
  @@map("payment_attempts")
}
