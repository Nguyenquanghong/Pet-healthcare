generator client {
  provider = "prisma-client-js"
  output = "../src/generated/client"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model ProofAppointment {
  id String @id
  ownerId String
  petId String
  date String
  time String
  type String
  status String
  revision Int @default(1)
}
model BillingReservation {
  operationId String @id
  appointmentId String
  revisionAtPrepare Int
  snapshot Json
  state String @default("HELD")
  invoiceId String?
}
model OutboxEvent {
  id String @id
  envelope Json
  createdAt DateTime @default(now())
  publishedAt DateTime?
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseOwner String?
  leaseUntil DateTime?
  lastErrorCode String?
  @@index([publishedAt, nextAttemptAt])
}
model InboxEvent {
  consumerName String
  eventId String
  createdAt DateTime @default(now())
  @@id([consumerName, eventId])
}
model DirectoryProjection {
  kind String
  id String
  sourceVersion Int
  displayName String
  ownerId String?
  species String?
  phone String?
  breed String?
  email String?
  microchipId String?
  updatedAt DateTime @default(now())
  deletedAt DateTime?
  @@id([kind, id])
}

enum AppointmentStatus {
  pending
  confirmed
  checked_in
  in_progress
  completed
  cancelled
  no_show
}

enum AppointmentType {
  general_checkup
  vaccination
  dental
  dermatology
  surgery
  hotel_consultation
  spa_bath
  spa_grooming
  spa_combo
  other
}

model Appointment {
  // SQL migration 20261019000100 adds a non-unique INCLUDE index for read ACL
  // ranges; Prisma schema cannot express its covering columns.
  id              String            @id @default(uuid())
  petId           String            @map("pet_id")
  ownerId         String            @map("owner_id")
  doctorId        String?           @map("doctor_id")
  type            AppointmentType
  serviceName     String            @map("service_name")
  clinicName      String            @map("clinic_name")
  appointmentDate DateTime          @map("appointment_date") @db.Date
  appointmentTime String            @map("appointment_time")
  status          AppointmentStatus @default(pending)
  statusRevision  Int               @default(0) @map("status_revision")
  ownerNote       String?           @map("owner_note")
  internalNote    String?           @map("internal_note")
  createdBy       String            @default("owner") @map("created_by")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  medicalRecords  MedicalRecord[]

  @@index([ownerId, appointmentDate])
  @@index([status, appointmentDate(sort: Desc), appointmentTime(sort: Desc), id(sort: Desc)], map: "appointments_page_idx")
  @@index([status, createdAt(sort: Desc), id(sort: Desc)], map: "appointments_admin_recent_idx")
  @@index([ownerId, status, appointmentDate(sort: Desc), appointmentTime(sort: Desc), id(sort: Desc)], map: "appointments_owner_page_idx")
  reservations AppointmentReservation[]
  statusEvents BookingStatusEvent[]
  @@map("appointments")
}

model MedicalRecord {
  id            String    @id @default(uuid())
  petId         String    @map("pet_id")
  ownerId       String    @map("owner_id")
  appointmentId String?   @map("appointment_id")
  doctorName    String    @map("doctor_name")
  visitDate     DateTime  @map("visit_date") @db.Date
  title         String
  symptoms      String?
  diagnosis     String
  treatment     String
  medications   String?
  vaccineName   String?   @map("vaccine_name")
  followUpDate  DateTime? @map("follow_up_date") @db.Date
  weightKg      Decimal?  @map("weight_kg") @db.Decimal(5, 2)
  temperatureC  Decimal?  @map("temperature_c") @db.Decimal(4, 1)
  heartRateBpm  Int?      @map("heart_rate_bpm")
  internalNote  String?   @map("internal_note")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([petId, visitDate])
  @@index([ownerId, visitDate, id], map: "medical_records_owner_page_idx")
  @@index([visitDate, id], map: "medical_records_page_idx")
  @@map("medical_records")
}

model MedicalImage {
  id        String   @id @default(uuid())
  ownerId String @map("owner_id")
  petId     String   @map("pet_id")
  title     String
  // AQ-09: exactly one of imageUrl (legacy base64 data URL, until the blob
  // migration tool has moved it) or storageKey (Claim Check into the bucket).
  imageUrl  String?  @map("image_url") @db.Text
  storageKey String? @unique @map("storage_key")
  sizeBytes Int?     @map("size_bytes")
  sha256    String?
  mimeType  String   @map("mime_type")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([petId])
  @@index([petId, createdAt, id], map: "medical_images_pet_page_idx")
  @@index([ownerId, createdAt, id], map: "medical_images_owner_page_idx")
  @@map("medical_images")
}

// AQ-09: bucket objects whose image row is gone but whose delete has not been
// confirmed yet. Written in the same transaction as the row delete; the worker
// retries until the object is removed.
model BlobCleanup {
  storageKey    String   @id @map("storage_key")
  createdAt     DateTime @default(now()) @map("created_at")
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")

  @@index([nextAttemptAt])
  @@map("blob_cleanup")
}

// AQ-15: append-only before/after history of medical record writes, written in
// the same transaction as the change. No FK, so history survives deletion; an
// UPDATE/DELETE trigger and runtime grants (INSERT/SELECT only) keep it immutable.
model MedicalRecordRevision {
  id        String   @id @default(uuid())
  recordId  String   @map("record_id")
  action    String
  before    Json?
  after     Json?
  actorId   String   @map("actor_id")
  actorRole String   @map("actor_role")
  changedAt DateTime @default(now()) @map("changed_at")

  @@index([recordId, changedAt, id], map: "medical_record_revisions_record_idx")
  @@map("medical_record_revisions")
}

model BookingStatusEvent {
  id          String @id @default(uuid())
  kind        String
  bookingId   String @map("booking_id")
  revision    Int
  action      String
  fromStatus  String @map("from_status")
  toStatus    String @map("to_status")
  actorId     String @map("actor_id")
  actorName   String @map("actor_name")
  actorRole   String @map("actor_role")
  reason      String?
  reversesId  String? @unique @map("reverses_id")
  reverses    BookingStatusEvent? @relation("BookingReversal", fields: [reversesId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reversedBy  BookingStatusEvent? @relation("BookingReversal")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([kind, bookingId, revision])
  @@index([kind, bookingId, createdAt], map: "booking_status_events_booking_idx")
  appointment Appointment @relation(fields: [bookingId], references: [id])
  @@map("booking_status_events")
}

model AppointmentReservation {
 operationId String @id
 appointmentId String
 revisionAtPrepare Int
 snapshot Json
 state String @default("HELD")
 invoiceId String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 appointment Appointment @relation(fields: [appointmentId], references: [id])
 @@index([appointmentId,state])
}
// Terminal evidence can arrive before a delayed prepare. Retain it for replay.
model AppointmentBillingTerminal {
 operationId String @id
 appointmentId String
 state String
 invoiceId String?
 createdAt DateTime @default(now())
}
model RequestDedup {
 id String @id
 actorId String
 operationType String
 key String
 requestHash String
 resourceId String
 responsePayload Json
 readVersions Json @default("{}")
 createdAt DateTime @default(now())
 @@unique([actorId,operationType,key])
}

// Independent read version: reservation/note changes are not statusRevision.
// No source FK: tombstones must survive a future supported source deletion.
model ClinicReadRevision {
 kind String
 aggregateId String
 version Int
 deleted Boolean @default(false)
 changedAt DateTime @default(now())
 @@id([kind,aggregateId])
}

enum ReadGenerationState {
 BUILDING
 READY
 ACTIVE
 RETIRED
}
model ReadProjectionGeneration {
 id String @id
 projectionName String @default("appointments")
 schemaVersion Int @default(1)
 state ReadGenerationState @default(BUILDING)
 startedAt DateTime @default(now())
 verifiedAt DateTime?
 rows AppointmentReadRow[]
 summaries AppointmentDailySummary[]
 activeIn ReadProjectionControl[]
 // SQL migration 20261021000100 adds CHECK schemaVersion IN (1,2) and a trigger
 // making schemaVersion immutable: V1 is never upgraded to V2 in place.
 @@unique([id,schemaVersion])
}
model ReadProjectionControl {
 projectionName String @id
 activeGenerationId String?
 servingMode String @default("authoritative")
 // Column-level UPDATE permits FOR SHARE without granting pointer/mode changes.
 lockAnchor Boolean @default(true)
 activeGeneration ReadProjectionGeneration? @relation(fields:[activeGenerationId],references:[id],onDelete:Restrict)
}
model AppointmentQueryEpoch {
 scope String @id
 revision BigInt @default(1)
}

model AppointmentReadRow {
  // SQL migration 20261019000100 adds the partial INCLUDE aggregate range
  // index. Keep its deletedAt predicate/covering columns in migration SQL.
 generation String
 appointmentId String
 sourceVersion Int
 petId String
 ownerId String
 doctorId String?
 type AppointmentType
 serviceName String
 clinicName String
 appointmentDate DateTime @db.Date
 appointmentTime String
 status AppointmentStatus
 statusRevision Int
 ownerNote String?
 internalNote String?
 createdBy String
 createdAt DateTime
 updatedAt DateTime
 billingHeld Boolean
 billingInvoiced Boolean
 deletedAt DateTime?
 projectedAt DateTime @default(now())
 generationRecord ReadProjectionGeneration @relation(fields:[generation],references:[id],onDelete:Restrict)
 @@id([generation,appointmentId])
 @@index([generation,deletedAt,status,createdAt(sort: Desc),appointmentId(sort: Desc)], map: "appointment_read_admin_page_idx")
 @@index([generation,deletedAt,ownerId,status,appointmentDate(sort: Desc),appointmentTime(sort: Desc),appointmentId(sort: Desc)], map: "appointment_read_owner_page_idx")
}

// Projection V2 daily activity counter: live AppointmentReadRow count per
// (generation, appointment date, type, current status). SQL migration adds
// CHECK appointmentCount>=0 and schemaVersion=2; the composite FK makes summary
// rows impossible for a V1 generation. Zero rows are retained. No PII/billing.
model AppointmentDailySummary {
 generation String
 appointmentDate DateTime @db.Date
 type AppointmentType
 status AppointmentStatus
 schemaVersion Int @default(2)
 appointmentCount BigInt @default(0)
 generationRecord ReadProjectionGeneration @relation(fields:[generation,schemaVersion],references:[id,schemaVersion],onDelete:Restrict,onUpdate:Restrict)
 @@id([generation,appointmentDate,type,status])
}

// Operator-owned activity serving mode singleton (SQL CHECK id=1 and mode).
// The summary generation is read indirectly from ReadProjectionControl
// ('appointments'); there is deliberately no second generation pointer.
model ClinicActivityControl {
 id Int @id @default(1)
 servingMode String @default("source")
 updatedAt DateTime @default(now())
}

// Durable trial rebuild fence/checkpoint. Only an operator may mutate this table.
model ReadRebuildRun {
 id String @id
 generation String @unique
 expectedGeneration String?
 ownerPid Int
 frozen Boolean @default(true)
 checkpoint String?
 sourceHash String?
 state String @default("BUILDING")
 copied Int @default(0)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
