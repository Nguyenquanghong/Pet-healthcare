{
  "openapi": "3.0.3",
  "info": {
    "title": "Notification API",
    "version": "2.0.0",
    "description": "Actor-scoped inbox. Manual send checks Core and commits local dedup/effect without waiting for broker. No live data cutover implied."
  },
  "paths": {
    "/api/notifications": {
      "get": {
        "operationId": "listNotifications",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Actor-scoped page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired actor token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service or authentication configuration unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "id",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "sent",
                "read"
              ]
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "appointments",
                "hotel",
                "medical",
                "promo"
              ]
            }
          }
        ]
      }
    },
    "/api/notifications/unread-count": {
      "get": {
        "operationId": "unreadNotificationCount",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authoritative actor-scoped count",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "unread",
                    "asOf"
                  ],
                  "properties": {
                    "unread": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "asOf": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired actor token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service or authentication configuration unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/notifications/read-all": {
      "patch": {
        "operationId": "markAllNotificationsRead",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Actor-scoped notifications marked read",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired actor token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service or authentication configuration unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/notifications/{id}/read": {
      "patch": {
        "operationId": "markNotificationRead",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Visible notification marked read",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "notification"
                  ],
                  "properties": {
                    "notification": {
                      "$ref": "#/components/schemas/Notification"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired actor token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Notification invisible or missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service or authentication configuration unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/notifications/{id}": {
      "delete": {
        "operationId": "deleteNotification",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Visible notification deleted; inbox history retained"
          },
          "401": {
            "description": "Missing, invalid or expired actor token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Notification invisible or missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service or authentication configuration unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/notifications/send": {
      "post": {
        "operationId": "sendNotification",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "recipientOwnerId",
                  "title",
                  "message"
                ],
                "properties": {
                  "recipientOwnerId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Committed notification; cached response on retry",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "notification"
                  ],
                  "properties": {
                    "notification": {
                      "$ref": "#/components/schemas/Notification"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Actor/recipient/content/key or dependency error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Actor/recipient/content/key or dependency error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Actor/recipient/content/key or dependency error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Actor/recipient/content/key or dependency error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Actor/recipient/content/key or dependency error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Actor/recipient/content/key or dependency error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT RS256"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Notification": {
        "type": "object",
        "required": [
          "id",
          "recipientOwnerId",
          "recipientRole",
          "type",
          "title",
          "message",
          "status",
          "actionUrl",
          "relatedPetId",
          "relatedAppointmentId",
          "relatedBookingId",
          "sentByStaffId",
          "createdAt",
          "sentAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "recipientOwnerId": {
            "type": "string",
            "nullable": true
          },
          "recipientRole": {
            "enum": [
              "owner",
              "admin"
            ]
          },
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "status": {
            "enum": [
              "sent",
              "read"
            ]
          },
          "actionUrl": {
            "type": "string",
            "nullable": true
          },
          "relatedPetId": {
            "type": "string",
            "nullable": true
          },
          "relatedAppointmentId": {
            "type": "string",
            "nullable": true
          },
          "relatedBookingId": {
            "type": "string",
            "nullable": true
          },
          "sentByStaffId": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "sentAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Page": {
        "type": "object",
        "required": [
          "items",
          "pagination",
          "counts",
          "related"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Notification"
            }
          },
          "pagination": {
            "type": "object",
            "required": [
              "page",
              "pageSize",
              "total",
              "totalPages"
            ],
            "properties": {
              "page": {
                "type": "integer"
              },
              "pageSize": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              },
              "totalPages": {
                "type": "integer"
              }
            }
          },
          "counts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "related": {
            "type": "object",
            "properties": {
              "owners": {
                "type": "array",
                "items": {
                  "type": "object"
                },
                "maxItems": 0
              },
              "pets": {
                "type": "array",
                "items": {
                  "type": "object"
                },
                "maxItems": 0
              },
              "appointments": {
                "type": "array",
                "items": {
                  "type": "object"
                },
                "maxItems": 0
              },
              "hotelBookings": {
                "type": "array",
                "items": {
                  "type": "object"
                },
                "maxItems": 0
              },
              "medicalRecords": {
                "type": "array",
                "items": {
                  "type": "object"
                },
                "maxItems": 0
              },
              "medicalImages": {
                "type": "array",
                "items": {
                  "type": "object"
                },
                "maxItems": 0
              },
              "dailyCareNotes": {
                "type": "array",
                "items": {
                  "type": "object"
                },
                "maxItems": 0
              },
              "notifications": {
                "type": "array",
                "items": {
                  "type": "object"
                },
                "maxItems": 0
              },
              "invoices": {
                "type": "array",
                "items": {
                  "type": "object"
                },
                "maxItems": 0
              }
            }
          }
        }
      }
    }
  }
}
